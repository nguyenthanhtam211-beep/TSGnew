        }
        lines {
          text: "               {filteredDelivery.filter(d => d[\"S\341\273\261 c\341\273\221\"] && d[\"S\341\273\261 c\341\273\221\"] !== \"0\" && String(d[\"S\341\273\261 c\341\273\221\"]).trim() !== \"\").length > 0 ? ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                 filteredDelivery.filter(d => d[\"S\341\273\261 c\341\273\221\"] && d[\"S\341\273\261 c\341\273\221\"] !== \"0\" && String(d[\"S\341\273\261 c\341\273\221\"]).trim() !== \"\").map((incident, idx) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const incidentId = incident.id || incident.ID || `${incident[\"S\341\273\221 PXK\"] || incident[\"\304\220\306\241n h\303\240ng\"]}-${idx}`;"
