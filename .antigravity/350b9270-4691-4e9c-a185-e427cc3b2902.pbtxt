        }
        lines {
          text: "  const revenueGrowthData = useMemo(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let runningTotal = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
