        }
        lines {
          text: "            <Activity className=\"text-emerald-500\" size={18} /> Ph\303\242n b\341\273\225 V\303\262ng \304\221\341\273\235i \304\220\306\241n h\303\240ng (To\303\240n h\341\273\207 th\341\273\221ng)"
