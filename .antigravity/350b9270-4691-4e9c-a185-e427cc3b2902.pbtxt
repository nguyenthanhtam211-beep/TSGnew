          text: "                <>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <div className=\"absolute left-[8%] right-[8%] top-5 h-1.5 bg-gray-100 rounded-full z-0\"></div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  {steps.map((step, idx) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const percent = Math.round((step.count / total) * 100);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <div key={step.label} className=\"relative z-10 flex flex-col items-center gap-3 w-1/4 group\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm text-white ring-8 shadow-md transition-transform group-hover:scale-110 ${step.color} ${step.ring}`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
