        }
        lines {
          text: "                    const currentDelivery = parseFloat(String(d[\"S\341\273\221 l\306\260\341\273\243ng giao\"] || \"0\").replace(/,/g, \'\')) || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
