    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // --- AI INSIGHTS ---\n  const AIInsight = ({ title = \"AI Nh\341\272\255n x\303\251t\", content }: { title?: string, content: React.ReactNode }) => (\n    <div className=\"mt-6 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100/60 flex items-start gap-3 print:break-inside-avoid\">\n      <div className=\"p-2 bg-indigo-100/80 rounded-lg text-indigo-600 shrink-0\">\n        <Sparkles size={16} />\n      </div>\n      <div>\n        <h4 className=\"text-[13px] font-bold text-indigo-900 mb-1\">{title}</h4>\n        <p className=\"text-[13px] text-indigo-900/80 leading-relaxed\">{content}</p>\n      </div>\n    </div>\n  );\n\n  const completedTrendInsight = useMemo(() => {\n    if (!completedMonthlyTrendData || completedMonthlyTrendData.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u \304\221\341\273\203 ph\303\242n t\303\255ch.\";\n    const maxMonth = [...completedMonthlyTrendData].sort((a,b) => b.revenue - a.revenue)[0];\n    const maxProfitMonth = [...completedMonthlyTrendData].sort((a,b) => b.profit - a.profit)[0];\n    return (\n      <>Th\303\241ng c\303\263 doanh thu t\341\273\253 c\303\241c \304\221\306\241n h\303\240ng ho\303\240n th\303\240nh cao nh\341\272\245t l\303\240 <strong>{maxMonth.month}</strong> \304\221\341\272\241t <strong>{formatter.format(maxMonth.revenue)}</strong>. L\341\273\243i nhu\341\272\255n cao nh\341\272\245t r\306\241i v\303\240o <strong>{maxProfitMonth.month}</strong> v\341\273\233i <strong>{formatter.format(maxProfitMonth.profit)}</strong>. C\341\272\247n duy tr\303\254 hi\341\273\207u su\341\272\245t giao h\303\240ng \304\221\341\273\203 \304\221\341\272\251y nhanh t\341\273\221c \304\221\341\273\231 ghi nh\341\272\255n doanh thu.</>\n    );\n  }, [completedMonthlyTrendData]);\n\n  const netProfitInsight = useMemo(() => {\n    if (!monthlyTrendData || monthlyTrendData.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u \304\221\341\273\203 ph\303\242n t\303\255ch.\";\n    const maxProfitMonth = [...monthlyTrendData].sort((a,b) => b.profit - a.profit)[0];\n    const total = monthlyTrendData.reduce((acc, d) => acc + d.profit, 0);\n    const monthsWithData = monthlyTrendData.filter(d => d.profit !== 0).length || 1;\n    const avg = total / monthsWithData;\n    return (\n      <>L\341\273\243i nhu\341\272\255n r\303\262ng cao nh\341\272\245t v\303\240o <strong>{maxProfitMonth.month}</strong> ({formatter.format(maxProfitMonth.profit)}), trung b\303\254nh \304\221\341\272\241t <strong>{formatter.format(avg)}</strong> m\341\273\227i th\303\241ng. \304\220\341\273\223 th\341\273\213 cho th\341\272\245y m\341\273\251c \304\221\341\273\231 \341\273\225n \304\221\341\273\213nh c\341\273\247a l\341\273\243i nhu\341\272\255n, c\341\272\247n theo d\303\265i bi\341\272\277n \304\221\341\273\231ng chi ph\303\255 \304\221\341\272\247u v\303\240o.</>\n    );\n  }, [monthlyTrendData]);\n\n  const categoryInsight = useMemo(() => {\n    if (!categoryStats || categoryStats.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u.\";\n    const topCat = categoryStats[0];\n    return (\n      <>Nh\303\263m h\303\240ng <strong>{topCat.name}</strong> \304\221ang d\341\272\253n \304\221\341\272\247u, chi\341\272\277m t\341\273\267 tr\341\273\215ng cao nh\341\272\245t h\341\273\207 th\341\273\221ng. \304\220\341\272\251y m\341\272\241nh c\303\241c ch\303\255nh s\303\241ch b\303\241n h\303\240ng cho nh\303\263m n\303\240y \304\221\341\273\203 t\341\273\221i \306\260u h\303\263a bi\303\252n l\341\273\243i nhu\341\272\255n t\341\273\225ng th\341\273\203.</>\n    );\n  }, [categoryStats]);\n  \n  const customerInsight = useMemo(() => {\n    if (!customerStats || customerStats.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u.\";\n    const topCust = customerStats[0];\n    return (\n      <>Kh\303\241ch h\303\240ng <strong>{topCust.name}</strong> mang l\341\272\241i doanh thu cao nh\341\272\245t ({formatter.format(topCust.revenue)}). C\303\263 th\341\273\203 \303\241p d\341\273\245ng ch\306\260\306\241ng tr\303\254nh chi\341\272\277t kh\341\272\245u ho\341\272\267c \306\260u \304\221\303\243i \304\221\341\272\267c bi\341\273\207t \304\221\341\273\203 gi\341\273\257 ch\303\242n nh\303\263m kh\303\241ch VIP.</>\n    );\n  }, [customerStats]);\n\n  const supplierInsight = useMemo(() => {\n    if (!supplierStats || supplierStats.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u.\";\n    const topSup = supplierStats[0];\n    return (\n      <>Nh\303\240 cung c\341\272\245p <strong>{topSup.name}</strong> \304\221ang chi\341\272\277m t\341\273\267 tr\341\273\215ng mua h\303\240ng l\341\273\233n nh\341\272\245t. C\341\272\247n th\306\260\306\241ng l\306\260\341\273\243ng l\341\272\241i ch\303\255nh s\303\241ch gi\303\241 ho\341\272\267c \304\221i\341\273\201u kho\341\272\243n thanh to\303\241n \304\221\341\273\203 c\341\272\243i thi\341\273\207n d\303\262ng ti\341\273\201n.</>\n    );\n  }, [supplierStats]);\n\n  const COLORS = [\'#3b82f6\', \'#10b981\', \'#f59e0b\', \'#ef4444\', \'#8b5cf6\', \'#ec4899\'];\n\n  return (\n    <div className=\"flex-1 overflow-auto bg-gray-50/50 print:overflow-visible print:bg-white\">\n      <div className=\"p-8 max-w-[1400px] mx-auto print:max-w-none print:p-0\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8\">\n          <div>\n            <h2 className=\"text-2xl font-bold text-gray-900 tracking-tight\">T\341\273\225ng quan Ho\341\272\241t \304\221\341\273\231ng</h2>\n            <p className=\"text-sm text-gray-500 mt-1\">Ph\303\242n t\303\255ch chuy\303\252n s\303\242u s\341\272\243n l\306\260\341\273\243ng, doanh thu, l\341\273\243i nhu\341\272\255n v\303\240 ti\341\272\277n \304\221\341\273\231 giao h\303\240ng</p>\n          </div>"
      replacement_content: "  // --- AI INSIGHTS ---\n  const AIInsight = ({ title = \"Ph\303\242n t\303\255ch d\341\273\257 li\341\273\207u\", content }: { title?: string, content: React.ReactNode }) => (\n    <div className=\"mt-6 p-4 bg-indigo-50/50 rounded-xl border border-indigo-100/60 flex items-start gap-3 print:break-inside-avoid\">\n      <div className=\"p-2 bg-indigo-100/80 rounded-lg text-indigo-600 shrink-0\">\n        <Sparkles size={16} />\n      </div>\n      <div>\n        <h4 className=\"text-[13px] font-bold text-indigo-900 mb-1\">{title}</h4>\n        <p className=\"text-[13px] text-indigo-900/80 leading-relaxed\">{content}</p>\n      </div>\n    </div>\n  );\n\n  const completedTrendInsight = useMemo(() => {\n    if (!completedMonthlyTrendData || completedMonthlyTrendData.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u \304\221\341\273\203 ph\303\242n t\303\255ch.\";\n    const maxMonth = [...completedMonthlyTrendData].sort((a,b) => b.revenue - a.revenue)[0];\n    const maxProfitMonth = [...completedMonthlyTrendData].sort((a,b) => b.profit - a.profit)[0];\n    return (\n      <>Th\303\241ng c\303\263 doanh thu t\341\273\253 c\303\241c \304\221\306\241n h\303\240ng ho\303\240n th\303\240nh cao nh\341\272\245t l\303\240 <strong>{maxMonth.month}</strong> \304\221\341\272\241t <strong>{formatter.format(maxMonth.revenue)}</strong>. L\341\273\243i nhu\341\272\255n cao nh\341\272\245t r\306\241i v\303\240o <strong>{maxProfitMonth.month}</strong> v\341\273\233i <strong>{formatter.format(maxProfitMonth.profit)}</strong>. C\341\272\247n duy tr\303\254 hi\341\273\207u su\341\272\245t giao h\303\240ng \304\221\341\273\203 \304\221\341\272\251y nhanh t\341\273\221c \304\221\341\273\231 ghi nh\341\272\255n doanh thu.</>\n    );\n  }, [completedMonthlyTrendData]);\n\n  const netProfitInsight = useMemo(() => {\n    if (!monthlyTrendData || monthlyTrendData.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\