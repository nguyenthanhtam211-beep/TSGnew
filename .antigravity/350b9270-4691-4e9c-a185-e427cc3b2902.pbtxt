          text: "                         <div className=\"flex flex-col gap-1.5\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            <div className=\"flex justify-between text-xs font-medium\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                               <span className={isCompleted ? \'text-green-600\' : \'text-blue-600\'}>{calculatedProgress.toFixed(1)}%</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
