          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <div className=\"text-xs text-gray-500 mt-0.5\">{d[\"S\341\273\221 PXK\"] || \"Ch\306\260a c\303\263 PXK\"}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
