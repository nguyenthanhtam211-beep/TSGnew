        lines {
          text: "      <>Nh\303\240 cung c\341\272\245p <strong>{topSup.name}</strong> \304\221ang chi\341\272\277m t\341\273\267 tr\341\273\215ng mua h\303\240ng l\341\273\233n nh\341\272\245t. C\341\272\247n th\306\260\306\241ng l\306\260\341\273\243ng l\341\272\241i ch\303\255nh s\303\241ch gi\303\241 ho\341\272\267c \304\221i\341\273\201u kho\341\272\243n thanh to\303\241n \304\221\341\273\203 c\341\272\243i thi\341\273\207n d\303\262ng ti\341\273\201n.</>"
