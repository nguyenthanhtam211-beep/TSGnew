          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (!monthlyTrendData || monthlyTrendData.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u \304\221\341\273\203 ph\303\242n t\303\255ch.\";"
