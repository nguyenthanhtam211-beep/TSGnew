        }
        lines {
          text: "                    const currentDelivery = parseFloat(String(d[\"S\341\273\221 l\306\260\341\273\243ng giao\"] || \"0\").replace(/,/g, \'\')) || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const prevDelivered = parseFloat(String(d[\"\304\220\303\243 giao\"] || \"0\").replace(/,/g, \'\')) || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const orderTotal = parseFloat(String(d[\"S\341\273\221 l\306\260\341\273\243ng \304\221\341\272\267t\"] || \"0\").replace(/,/g, \'\')) || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
