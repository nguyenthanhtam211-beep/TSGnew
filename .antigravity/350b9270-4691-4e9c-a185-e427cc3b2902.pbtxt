        }
        lines {
          text: "            {(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const steps = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                { label: \'M\341\273\233i t\341\272\241o\', count: overallPoLifecycle.newPos, color: \'bg-slate-400\', ring: \'ring-slate-100\' },"
