          text: "    if (!completedMonthlyTrendData || completedMonthlyTrendData.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u \304\221\341\273\203 ph\303\242n t\303\255ch.\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const maxMonth = [...completedMonthlyTrendData].sort((a,b) => b.revenue - a.revenue)[0];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const maxProfitMonth = [...completedMonthlyTrendData].sort((a,b) => b.profit - a.profit)[0];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <>Th\303\241ng c\303\263 doanh thu t\341\273\253 c\303\241c \304\221\306\241n h\303\240ng ho\303\240n th\303\240nh cao nh\341\272\245t l\303\240 <strong>{maxMonth.month}</strong> \304\221\341\272\241t <strong>{formatter.format(maxMonth.revenue)}</strong>. L\341\273\243i nhu\341\272\255n cao nh\341\272\245t r\306\241i v\303\240o <strong>{maxProfitMonth.month}</strong> v\341\273\233i <strong>{formatter.format(maxProfitMonth.profit)}</strong>. C\341\272\247n duy tr\303\254 hi\341\273\207u su\341\272\245t giao h\303\240ng \304\221\341\273\203 \304\221\341\272\251y nhanh t\341\273\221c \304\221\341\273\231 ghi nh\341\272\255n doanh thu.</>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }, [completedMonthlyTrendData]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const netProfitInsight = useMemo(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (!monthlyTrendData || monthlyTrendData.length === 0) return \"Ch\306\260a c\303\263 \304\221\341\273\247 d\341\273\257 li\341\273\207u \304\221\341\273\203 ph\303\242n t\303\255ch.\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const maxProfitMonth = [...monthlyTrendData].sort((a,b) => b.profit - a.profit)[0];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const total = monthlyTrendData.reduce((acc, d) => acc + d.profit, 0);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const monthsWithData = monthlyTrendData.filter(d => d.profit !== 0).length || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const avg = total / monthsWithData;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <>L\341\273\243i nhu\341\272\255n r\303\262ng cao nh\341\272\245t v\303\240o <strong>{maxProfitMonth.month}</strong> ({formatter.format(maxProfitMonth.profit)}), trung b\303\254nh \304\221\341\272\241t <strong>{formatter.format(avg)}</strong> m\341\273\227i th\303\241ng. \304\220\341\273\223 th\341\273\213 cho th\341\272\245y m\341\273\251c \304\221\341\273\231 \341\273\225n \304\221\341\273\213nh c\341\273\247a l\341\273\243i nhu\341\272\255n, c\341\272\247n theo d\303\265i bi\341\272\277n \304\221\341\273\231ng chi ph\303\255 \304\221\341\272\247u v\303\240o.</>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
