          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                               <span className={isCompleted ? \'text-green-600\' : \'text-blue-600\'}>{calculatedProgress.toFixed(1)}%</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                               <span className=\"text-gray-500\">{numFormatter.format(totalDelivered)} / {numFormatter.format(orderTotal)} {d[\"\304\220VT\"]}</span>"
