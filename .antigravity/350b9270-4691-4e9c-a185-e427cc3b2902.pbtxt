        }
        lines {
          text: "                     <p className=\"text-sm text-green-700 mt-1\">T\341\272\245t c\341\272\243 c\303\241c l\303\264 h\303\240ng \304\221ang \304\221\341\272\241t chu\341\272\251n ch\341\272\245t l\306\260\341\273\243ng QC.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
