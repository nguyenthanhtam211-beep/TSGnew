          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <div className=\"text-xs text-gray-500 mt-0.5\">Kh\303\241ch h\303\240ng: {d[\"Kh\303\241ch h\303\240ng\"]}</div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
