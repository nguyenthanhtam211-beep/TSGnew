    replacement_chunks {
      target_content: "  const handleExportPDF = async () => {\n    if (!dashboardRef.current) return;\n    try {\n      setIsExportingPDF(true);\n      toast.loading(\"\304\220ang t\341\272\241o file PDF, vui l\303\262ng \304\221\341\273\243i...\", { id: \"pdf-export\" });\n      \n      const canvas = await html2canvas(dashboardRef.current, {\n        scale: 2,\n        useCORS: true,\n        logging: false,\n        backgroundColor: \'#ffffff\'\n      });\n      \n      const imgData = canvas.toDataURL(\'image/png\');\n      const pdf = new jsPDF({\n        orientation: \'portrait\',\n        unit: \'mm\',\n        format: \'a4\'\n      });\n      \n      const pdfWidth = pdf.internal.pageSize.getWidth();\n      const pdfHeight = (canvas.height * pdfWidth) / canvas.width;\n      \n      // If content is longer than one page, we might need multiple pages, \n      // but for simplicity we will just put it on one long page or scale to fit width\n      // Since it\'s a dashboard, it might span multiple pages.\n      let heightLeft = pdfHeight;\n      let position = 0;\n      const pageHeight = pdf.internal.pageSize.getHeight();\n\n      pdf.addImage(imgData, \'PNG\', 0, position, pdfWidth, pdfHeight);\n      heightLeft -= pageHeight;\n\n      while (heightLeft >= 0) {\n        position = heightLeft - pdfHeight;\n        pdf.addPage();\n        pdf.addImage(imgData, \'PNG\', 0, position, pdfWidth, pdfHeight);\n        heightLeft -= pageHeight;\n      }\n      \n      pdf.save(\'TSG_Dashboard.pdf\');\n      toast.success(\"\304\220\303\243 xu\341\272\245t PDF th\303\240nh c\303\264ng!\", { id: \"pdf-export\" });\n    } catch (error) {\n      console.error(\"PDF Export error:\", error);\n      toast.error(\"L\341\273\227i khi xu\341\272\245t PDF!\", { id: \"pdf-export\" });\n    } finally {\n      setIsExportingPDF(false);\n    }\n  };"
