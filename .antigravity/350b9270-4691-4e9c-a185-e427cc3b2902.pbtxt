          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                { label: \'\304\220ang x\341\273\255 l\303\275\', count: overallPoLifecycle.processing, color: \'bg-blue-500\', ring: \'ring-blue-50\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                { label: \'\304\220ang giao\', count: overallPoLifecycle.delivering, color: \'bg-amber-500\', ring: \'ring-amber-50\' },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                { label: \'Ho\303\240n th\303\240nh\', count: overallPoLifecycle.completed, color: \'bg-emerald-500\', ring: \'ring-emerald-50\' }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              ];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              const total = overallPoLifecycle.total || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
