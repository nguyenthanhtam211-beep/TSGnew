        }
        lines {
          text: "        <h4 className=\"text-[13px] font-bold text-slate-800 mb-1 uppercase tracking-wide\">{title}</h4>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <p className=\"text-[13px] text-slate-600 leading-relaxed\">{content}</p>"
